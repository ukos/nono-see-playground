{"id": "hanano", "kanten": ["○", "○", "○", "○", "○", "○", "△", "○"], "axes": [4, 3, 4, 4, 4, 4, 5, 4], "total": 32, "gate": "合格", "curve": [{"talk": "ゴンジ-1", "tension": 2, "expect": 4, "laugh": 1, "surprise": 3, "empathy": 2}, {"talk": "長老-1", "tension": 1, "expect": 3, "laugh": 3, "surprise": 1, "empathy": 1}, {"talk": "ダイ-1", "tension": 2, "expect": 4, "laugh": 3, "surprise": 3, "empathy": 1}, {"talk": "ミツ-1", "tension": 2, "expect": 4, "laugh": 1, "surprise": 3, "empathy": 2}, {"talk": "吊り橋", "tension": 2, "expect": 3, "laugh": 1, "surprise": 4, "empathy": 2}, {"talk": "長老-2", "tension": 1, "expect": 2, "laugh": 3, "surprise": 1, "empathy": 2}, {"talk": "ゴンジ-2", "tension": 1, "expect": 2, "laugh": 3, "surprise": 2, "empathy": 4}, {"talk": "ダイ-帰り", "tension": 1, "expect": 1, "laugh": 3, "surprise": 2, "empathy": 2}], "curve_note": "噂→証言→実見の上り坂のあと、長老とダイの笑いで一息つき、ゴンジの告白で共感が上がる。", "note": "噂の確信度、帰りに直っている吊り橋、帰り道で分かる音の正体と、SEE の核がそろっている。花野の村らしさ（花・暮らし）が会話にほとんど出ない点だけが弱い。", "bugs": []}
{"id": "take", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 4, 4, 4, 4, 4, 4, 4], "total": 32, "gate": "合格", "curve": [{"talk": "若い衆-1", "tension": 2, "expect": 4, "laugh": 4, "surprise": 2, "empathy": 1}, {"talk": "そば屋", "tension": 2, "expect": 3, "laugh": 2, "surprise": 2, "empathy": 3}, {"talk": "若い衆-2", "tension": 1, "expect": 2, "laugh": 3, "surprise": 3, "empathy": 3}, {"talk": "そば屋-帰り", "tension": 1, "expect": 2, "laugh": 2, "surprise": 2, "empathy": 4}, {"talk": "若い衆-帰り", "tension": 1, "expect": 1, "laugh": 3, "surprise": 2, "empathy": 4}], "curve_note": "たくらみ（笑い）→正直な返事（小さな緊張）→たくらみが崩れる（笑い）→帰りの「うまかった」（共感）と、一往復ごとに波が変わる。", "note": "『時そば』を、旅人が口裏合わせを頼まれる話に作り替え、正直に答えただけでたくらみが止まる。原作の筋をなぞらず、旅人の立場が効いている。", "bugs": []}
{"id": "koutou", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 4, 4, 5, 4, 4, 4, 4], "total": 33, "gate": "合格", "curve": [{"talk": "女将", "tension": 2, "expect": 4, "laugh": 1, "surprise": 3, "empathy": 4}, {"talk": "赤い服の娘", "tension": 1, "expect": 2, "laugh": 2, "surprise": 1, "empathy": 1}, {"talk": "亭主", "tension": 2, "expect": 3, "laugh": 1, "surprise": 5, "empathy": 5}, {"talk": "亭主-帰り", "tension": 1, "expect": 1, "laugh": 2, "surprise": 2, "empathy": 5}, {"talk": "女将-帰り", "tension": 1, "expect": 2, "laugh": 2, "surprise": 2, "empathy": 4}], "curve_note": "女将の告白でいきなり期待を上げ、亭主の「知ってるよ」で驚きと共感が最大に。帰りの魚一匹で静かに締まる。", "note": "『芝浜』を、うそをつく妻と、気づかないふりの夫の二重の秘密に組み替えた。帰り道の「魚を一匹よけいに」で、二人とも言葉にしないまま礼を交わすのが余韻として強い。", "bugs": []}
{"id": "kaze", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 4, 3, 4, 4, 4, 5, 4], "total": 32, "gate": "合格", "curve": [{"talk": "メイ", "tension": 3, "expect": 4, "laugh": 1, "surprise": 1, "empathy": 4}, {"talk": "ハヤテ", "tension": 2, "expect": 3, "laugh": 3, "surprise": 1, "empathy": 2}, {"talk": "鈴の音", "tension": 2, "expect": 4, "laugh": 1, "surprise": 3, "empathy": 2}, {"talk": "メイ-帰り", "tension": 1, "expect": 2, "laugh": 2, "surprise": 4, "empathy": 5}], "curve_note": "緊張と期待で始まり、ハヤテの馬の冗談で一度ゆるみ、帰りの羊で驚きと共感が上がる。", "note": "旅人がただ歩いて帰っただけで、はぐれた羊を連れて帰っていた。歩くこと自体が話になる、SEE でしかできない国。ハヤテの口調がやや説明役に寄る。", "bugs": []}
{"id": "iro", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 3, 4, 4, 4, 4, 5, 4], "total": 32, "gate": "合格", "curve": [{"talk": "コガネ", "tension": 1, "expect": 3, "laugh": 3, "surprise": 2, "empathy": 2}, {"talk": "タヌリオ", "tension": 1, "expect": 3, "laugh": 3, "surprise": 3, "empathy": 3}, {"talk": "白いシャツの娘", "tension": 2, "expect": 3, "laugh": 1, "surprise": 2, "empathy": 1}, {"talk": "コガネ-帰り", "tension": 1, "expect": 1, "laugh": 4, "surprise": 2, "empathy": 2}], "curve_note": "値切りの笑い→旅の話で値段が決まる驚き→帰りのコガネの嘆きで笑いが一番高くなる。", "note": "旅人がそれまでの国で見聞きした話が、そのまま値段になる。話の中身はどの国を通ってきたかで変わり、旅の積み重ねが効く。賭けは小さい。", "bugs": []}
{"id": "suna", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 4, 4, 4, 4, 4, 4, 4], "total": 32, "gate": "合格", "curve": [{"talk": "ファースト", "tension": 3, "expect": 4, "laugh": 2, "surprise": 2, "empathy": 1}, {"talk": "イワオ-1", "tension": 2, "expect": 3, "laugh": 1, "surprise": 1, "empathy": 1}, {"talk": "魔法使い", "tension": 2, "expect": 4, "laugh": 3, "surprise": 2, "empathy": 1}, {"talk": "古い井戸", "tension": 2, "expect": 4, "laugh": 1, "surprise": 4, "empathy": 2}, {"talk": "イワオ-2", "tension": 1, "expect": 2, "laugh": 2, "surprise": 4, "empathy": 5}, {"talk": "ファースト-帰り", "tension": 1, "expect": 1, "laugh": 2, "surprise": 2, "empathy": 3}], "curve_note": "涸れる心配（緊張）から調べに行き、井戸の足あとで驚き、イワオの照れで共感へ。帰りのファーストの計算で安堵。", "note": "旅人が自分で足あとを見て、いちばん高く水を売る男の夜の顔を知る。ファーストの水脈の計算が、行きの心配と帰りの安堵を両方運ぶ。", "bugs": []}
{"id": "shirakabe", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 4, 4, 4, 4, 4, 4, 5], "total": 33, "gate": "合格", "curve": [{"talk": "剣を帯びた娘", "tension": 3, "expect": 3, "laugh": 1, "surprise": 2, "empathy": 3}, {"talk": "人魚", "tension": 1, "expect": 3, "laugh": 1, "surprise": 2, "empathy": 3}, {"talk": "使者", "tension": 2, "expect": 3, "laugh": 2, "surprise": 4, "empathy": 4}, {"talk": "使者-桟橋", "tension": 1, "expect": 3, "laugh": 3, "surprise": 2, "empathy": 3}, {"talk": "ユイ-2", "tension": 1, "expect": 3, "laugh": 2, "surprise": 3, "empathy": 4}, {"talk": "三人-帰り", "tension": 1, "expect": 1, "laugh": 4, "surprise": 2, "empathy": 4}], "curve_note": "争う二国の緊張から、灯台の光を七つ数えるという小さな共通点で一気に和らぐ。帰りの揚げ菓子の話で笑いに着地する。", "note": "敵国の使者と王女が、同じ灯台の光を七つ数えて眠っていた。旅人が二人の間を歩いて運ぶのはたった一言で、それが効く。「灯台の光を七つ」は思い出しやすい。", "bugs": []}
{"id": "kiri", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 4, 4, 4, 4, 4, 4, 4], "total": 32, "gate": "合格", "curve": [{"talk": "黒いスーツの娘", "tension": 2, "expect": 3, "laugh": 1, "surprise": 2, "empathy": 1}, {"talk": "赤いマフラーの女", "tension": 3, "expect": 4, "laugh": 1, "surprise": 2, "empathy": 2}, {"talk": "霧の森の人", "tension": 2, "expect": 3, "laugh": 1, "surprise": 1, "empathy": 1}, {"talk": "足音", "tension": 4, "expect": 4, "laugh": 1, "surprise": 3, "empathy": 1}, {"talk": "少年", "tension": 1, "expect": 2, "laugh": 4, "surprise": 5, "empathy": 3}, {"talk": "レイ-2", "tension": 1, "expect": 2, "laugh": 2, "surprise": 2, "empathy": 3}, {"talk": "レイ-帰り", "tension": 1, "expect": 1, "laugh": 3, "surprise": 2, "empathy": 4}], "curve_note": "霧の中の足音で緊張が最大になり、正体が少年だと分かって一気に笑いと驚きへ反転する。", "note": "霧で見えない国を、聞くことで歩く。追っている者が追われていた、という反転が、天候そのものから出ている。黒い外套の男の筋は、この国では解決しないまま東へ続く。", "bugs": []}
{"id": "yuki", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 4, 4, 4, 3, 5, 4, 4], "total": 32, "gate": "合格", "curve": [{"talk": "ヨル", "tension": 1, "expect": 3, "laugh": 2, "surprise": 2, "empathy": 3}, {"talk": "コテツ", "tension": 1, "expect": 3, "laugh": 1, "surprise": 2, "empathy": 4}, {"talk": "窓", "tension": 1, "expect": 2, "laugh": 1, "surprise": 3, "empathy": 5}, {"talk": "コテツ-帰り", "tension": 1, "expect": 1, "laugh": 1, "surprise": 2, "empathy": 5}, {"talk": "ヨル-帰り", "tension": 1, "expect": 1, "laugh": 2, "surprise": 1, "empathy": 4}], "curve_note": "全体に静かで、緊張は低いまま共感が上がり続ける。笑いはヨルだけ。", "note": "命のろうそくの夢を見た火守りから火を預かり、いちばん東の窓まで運ぶ。火を分けても手元の火が減らないことを、旅人が手の中で知る。静かすぎて、歩く間の変化はやや少ない。", "bugs": []}
{"id": "saka", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 4, 4, 4, 4, 4, 4, 4], "total": 32, "gate": "合格", "curve": [{"talk": "セカンド", "tension": 2, "expect": 4, "laugh": 2, "surprise": 2, "empathy": 1}, {"talk": "ミズチ", "tension": 1, "expect": 4, "laugh": 1, "surprise": 3, "empathy": 1}, {"talk": "シロ", "tension": 1, "expect": 2, "laugh": 2, "surprise": 3, "empathy": 5}, {"talk": "セカンド-2", "tension": 1, "expect": 2, "laugh": 3, "surprise": 3, "empathy": 3}, {"talk": "シロ-帰り", "tension": 1, "expect": 1, "laugh": 2, "surprise": 1, "empathy": 4}], "curve_note": "落とし物探しで期待を引っぱり、色の手がかりで驚き、シロの「眠れなかった」で共感、セカンドの「においがしない」で笑う。", "note": "色とりどりの坂の町で、色を手がかりに持ち主を探す。サハリアのファーストから預かった伝言が、ここでセカンドに届く。", "bugs": []}
{"id": "mizu", "kanten": ["○", "○", "○", "○", "○", "○", "○", "○"], "axes": [4, 4, 4, 5, 3, 4, 5, 4], "total": 33, "gate": "合格", "curve": [{"talk": "ミツ", "tension": 1, "expect": 3, "laugh": 2, "surprise": 3, "empathy": 4}, {"talk": "ゴウ", "tension": 3, "expect": 4, "laugh": 1, "surprise": 4, "empathy": 4}, {"talk": "水着の娘", "tension": 1, "expect": 1, "laugh": 3, "surprise": 1, "empathy": 1}, {"talk": "セカンド", "tension": 1, "expect": 2, "laugh": 2, "surprise": 3, "empathy": 3}, {"talk": "レイ", "tension": 1, "expect": 2, "laugh": 1, "surprise": 2, "empathy": 3}, {"talk": "ゴウ-帰り", "tension": 1, "expect": 1, "laugh": 3, "surprise": 2, "empathy": 5}], "curve_note": "床が浸かる心配と板の到着で山を作り、そのあとは再会の報告が続いて平らになる。", "note": "オランジェでミツが担いでいた板が、旅の終わりにゴウの床になる。旅人と同じ道を来た荷の到着として、最初の国と最後の国がつながる。回収する再登場人物が多く、後半は報告が続く。", "bugs": []}
